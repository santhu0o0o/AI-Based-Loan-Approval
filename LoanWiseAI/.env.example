# Example environment. Nothing loads this file automatically: export the variables in your
# shell, or pass the file to Docker (`docker run --env-file .env ...`). Every variable is optional;
# relative paths resolve against LOANWISE_ROOT (default: the repository root).

# LOANWISE_ROOT=/app
# LOANWISE_MODEL_PATH=artifacts/models/loan_model.pkl
# LOANWISE_MODEL_INFO_PATH=artifacts/models/model_info.json
# LOANWISE_DATABASE_PATH=instance/loanwise.db
# LOANWISE_TRAIN_DATA_PATH=data/raw/loan.csv
# LOANWISE_SAMPLE_DATA_PATH=data/raw/test.csv
# LOANWISE_EDA_DIR=artifacts/reports/eda
# LOANWISE_FRONTEND_DIST=frontend/dist

# Dev server only (gunicorn takes its bind address on the command line)
LOANWISE_HOST=127.0.0.1
LOANWISE_PORT=5000
LOANWISE_DEBUG=false

# Largest accepted request body, in bytes
LOANWISE_MAX_REQUEST_BYTES=32768

# Comma-separated origins (scheme://host, any port) allowed to call /api/* cross-origin
LOANWISE_CORS_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1

# Logging: level name and "text" or "json"
LOANWISE_LOG_LEVEL=INFO
LOANWISE_LOG_FORMAT=text
